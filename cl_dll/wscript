from waflib import Utils
import os

def options(opt):
	pass

def configure(conf):
	pass

def build(bld):
	libs = ['vcs_info']
	defines = ['CLIENT_DLL', 'CLIENT_WEAPONS', 'STDINT_H=<cstdint>']
	defines += bld.env.EXPORT_DEFINES_LIST

	includes = ['include',
		'include/hud',
		'include/studio',
		'include/math',
		'.',
		'../common',
		'../engine',
		'../pm_shared',
		'cs16_dlls',
		'../game_shared',
		'../public',
		'../public/cl_dll',
		'../external/miniutl',
		'particleman']

	# the same list of files as in CMakeLists.txt
	excluded_files = ['ev_hldm.cpp',
		'inputw32.cpp',
		'input/input_sdl.cpp',
		'cs_wpn/cs_baseentity.cpp']

	source = bld.path.ant_glob([
		'*.cpp',
		'events/*.cpp',
		'cs_wpn/*.cpp',
		'cs16_dlls/wpn_shared/*.cpp',
		'hud/*.cpp',
		'input/*.cpp',
		'particleman/*.cpp'
	], excl=excluded_files)
	source += bld.path.parent.ant_glob([
		'external/miniutl/*.cpp',
		'common/interface.cpp',
		'public/utflib.cpp',
		'pm_shared/pm_shared.c',
		'pm_shared/pm_math.c',
		'pm_shared/pm_debug.c'
	])

	cxxflags = []
	cflags = []
	if bld.env.COMPILER_CC == 'msvc':
		defines += ['_CRT_SECURE_NO_WARNINGS', '_CRT_NONSTDC_NO_DEPRECATE']
	else:
		defines += ['LINUX', '_LINUX',
			'stricmp=strcasecmp', '_strnicmp=strncasecmp', 'strnicmp=strncasecmp']
		cxxflags += ['-fms-extensions']
		cflags += ['-fms-extensions']

	if bld.env.DEST_OS == 'win32':
		libs += ['USER32']

	if 'HAVE_STRLCPY=1' not in defines:
		source += bld.path.parent.ant_glob('external/openbsd/strlcpy.c')
		source += bld.path.parent.ant_glob('public/strlcpy.c')

	if 'HAVE_STRLCAT=1' not in defines:
		source += bld.path.parent.ant_glob('external/openbsd/strlcat.c')
		source += bld.path.parent.ant_glob('public/strlcat.c')

	if bld.env.DEST_OS != 'dos' and not bld.env.ANDROID_APK:
		install_path = os.path.join(bld.env.GAMEDIR, bld.env.CLIENT_INSTALL_DIR)
	else:
		install_path = bld.env.PREFIX

	bld.shlib(
		source   = source,
		target   = 'client' + bld.env.POSTFIX,
		name     = 'client',
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		cflags   = cflags,
		cxxflags = cxxflags,
		use      = libs,
		install_path = install_path,
		idx = bld.get_taskgen_count()
	)
