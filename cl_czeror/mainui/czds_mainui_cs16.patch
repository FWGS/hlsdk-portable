+	EngFuncs::CvarSetValue( "coop", 0.0f );
+	EngFuncs::PlayBackgroundTrack( NULL, NULL );
+
+	// the training map of the game info (trainmap in liblist.gam)
+	EngFuncs::ClientCmdF( false, "map %s\n", gMenu.m_gameinfo.trainmap );
+}
